package com.movtery.zalithlauncher.game.download.modpack.autoinstall

import com.movtery.zalithlauncher.utils.logging.Logger
import org.apache.commons.compress.archivers.tar.TarArchiveInputStream
import org.tukaani.xz.XZInputStream
import java.io.BufferedInputStream
import java.io.File
import java.io.InputStream

private const val TAG = "XzExtractor"

/**
 * .tar.xz 解包工具
 *
 * 依赖 Apache Commons Compress（tar）与 XZ for Java（xz），
 * 两者均已在项目依赖中提供。
 */
object XzExtractor {

    /**
     * 预读 tar.xz，返回其中所有普通文件的大小之和
     *
     * 用途：解压前先拿到真实总量，进度才能算准。
     * 之前进度分母是拍脑袋写死的常数，与包的实际大小对不上，
     * 表现为进度条早早到 100% 后长时间不动。
     *
     * 注意：tar 条目的 header、以及 512 字节对齐的填充不计入，
     * 这与 [extract] 里累计的「写出字节数」口径一致，
     * 所以两者可以直接相除得到比例。
     *
     * 代价是要把 xz 流解一遍（不解到磁盘），对 400MB+ 的包约需数秒。
     *
     * @param input 压缩流。调用方需自行保证可重复打开（assets 用 open() 重新取）
     * @return 文件净字节和；读取失败返回 null
     */
    fun measure(input: InputStream): Long? = runCatching {
        var sum = 0L
        XZInputStream(BufferedInputStream(input, 64 * 1024)).use { xz ->
            TarArchiveInputStream(xz).use { tar ->
                while (true) {
                    val entry = tar.nextEntry ?: break
                    if (!entry.isDirectory) sum += entry.size
                }
            }
        }
        sum
    }.onFailure {
        Logger.warning(TAG, "预读压缩包大小失败，进度将退化为按已处理量显示", it)
    }.getOrNull()

    /**
     * 解压 tar.xz 流到目标目录
     *
     * @param input 压缩流
     * @param targetDir 解压目标目录
     * @param totalBytes 解压后总字节数。传了就按 0..1000 的千分比回调，
     *                   没传则回调累计字节数（供调用方自行估算）
     * @param onProgress 进度回调，含义见 totalBytes 说明
     */
    fun extract(
        input: InputStream,
        targetDir: File,
        totalBytes: Long? = null,
        onProgress: ((Long) -> Unit)? = null
    ) {
        var total = 0L
        val normalizedTarget = targetDir.canonicalFile

        XZInputStream(BufferedInputStream(input, 64 * 1024)).use { xz ->
            TarArchiveInputStream(xz).use { tar ->
                while (true) {
                    val entry = tar.nextEntry ?: break
                    val outFile = File(normalizedTarget, entry.name)

                    //阻止路径穿越（../ 逃逸）
                    if (!outFile.canonicalPath.startsWith(normalizedTarget.path + File.separator)) {
                        Logger.warning(TAG, "跳过越界条目: ${entry.name}")
                        continue
                    }

                    if (entry.isDirectory) {
                        outFile.mkdirs()
                        continue
                    }

                    outFile.parentFile?.mkdirs()
                    outFile.outputStream().use { output ->
                        val buffer = ByteArray(256 * 1024)
                        while (true) {
                            val read = tar.read(buffer)
                            if (read <= 0) break
                            output.write(buffer, 0, read)
                            total += read
                            //按真实总量上报千分比，避免出现「100% 之后还在跑」
                            if (totalBytes != null && totalBytes > 0) {
                                onProgress?.invoke((total * 1000L / totalBytes).coerceIn(0L, 1000L))
                            }
                        }
                    }
                    if (totalBytes == null) onProgress?.invoke(total)
                }
            }
        }
        //收尾：保证进度一定走到 1000（末块可能正好整除而没触发回调）
        if (totalBytes != null && totalBytes > 0) onProgress?.invoke(1000L)
        Logger.info(TAG, "解包完成，共写出 $total 字节到 ${normalizedTarget.absolutePath}")
    }
}